{
  "name": "@vamsa/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build": "tsup",
    "start": "bun run src/index.ts",
    "start:prod": "NODE_ENV=production bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent bun --bun vitest run",
    "test:coverage": "LOG_LEVEL=silent bun --bun vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@vamsa/lib": "workspace:*",
    "@vamsa/schemas": "workspace:*",
    "ai": "^7.0.0",
    "hono": "^4.11.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^26.0.0",
    "@vitest/coverage-istanbul": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
